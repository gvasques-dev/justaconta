# JustaConta — variáveis de ambiente
# Copie para .env e preencha.

# Django
SECRET_KEY=cole-uma-chave-aleatoria-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco (SQLite local / PostgreSQL Supabase em produção)
DATABASE_URL=sqlite:///db.sqlite3

# Supabase (opcional em dev, obrigatório em produção para arquivos)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=justaconta-documents
