# JustaConta — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.

# Django
SECRET_KEY=troque-por-uma-chave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Banco de dados
# Dev local: sqlite:///db.sqlite3
# Produção (Render + Supabase): postgresql://postgres.xxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Supabase (opcional em dev, obrigatório em produção para arquivos)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=justaconta-documents
